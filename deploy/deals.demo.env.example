# /etc/deals/deals.env en MODE DÉMO — installé par « sudo sh deploy/install.sh demo ».
# Démonstration : données simulées et fictives, aucune mention légale, aucun e-mail, aucun flux réel, aucun partenaire.
# Ce fichier ne doit jamais servir à la production : deals.env.example (DEALS_ENV=prod) est le seul modèle de production.

DEALS_ENV=demo

# Adresse de l'app vue du navigateur. Le port 8000 n'est pas ouvert sur Internet : on y accède par un tunnel SSH
# (ssh -L 8000:127.0.0.1:8000 <serveur>), puis http://127.0.0.1:8000/.
DEALS_PUBLIC_URL=http://127.0.0.1:8000

# Les liens de connexion (si quelqu'un se connecte) sont écrits dans ce fichier, lisible par le seul utilisateur deals.
# Aucun SMTP : rien ne part vers l'extérieur.
DEALS_OUTBOX=/var/lib/deals/outbox.log

# Données : base, brut des flux (vide en démo), rapports.
DEALS_RAW_DIR=/var/lib/deals/raw
DEALS_REPORTS_DIR=/var/lib/deals/reports
