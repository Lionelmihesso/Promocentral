# /etc/deals/offsite.env — copie chiffrée des sauvegardes hors du serveur (deals-offsite.service). Droits 600, root.
# Un bucket de stockage objet S3 (OVHcloud Object Storage : https://s3.<région>.io.cloud.ovh.net) et un utilisateur S3
# qui n'a accès qu'à ce bucket. Une valeur par ligne, sans commentaire en fin de ligne.
# Le mot de passe du dépôt chiffre tout : gardez-en une copie HORS du serveur (gestionnaire de mots de passe). Sans lui,
# la copie est illisible, y compris pour vous.
RESTIC_REPOSITORY=s3:https://s3.gra.io.cloud.ovh.net/promocentral-sauvegardes
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=gra
