# /etc/deals/deals.env — lu par les services systemd et par la commande « deals » (droits 600, propriétaire root).
# Une valeur par ligne, sans commentaire en fin de ligne : systemd le garderait dans la valeur (DEALS refuse alors de
# démarrer et nomme la variable).

# Le robot se présente aux enseignes : nom, page qui le décrit, contact. Obligatoire pour lire les sites.
DEALS_USER_AGENT=DealsBot/1.0 (+https://deals.example.fr/robot ; contact : robot@deals.example.fr)

# Adresse publique de l'app : liens de connexion ; en https, le cookie de session est marqué Secure.
DEALS_PUBLIC_URL=https://deals.example.fr

# Envoi des liens de connexion, n'importe quel fournisseur SMTP.
# DEALS_SMTP_TLS : starttls (port 587) | ssl (port 465) | none (relais local uniquement).
DEALS_SMTP_HOST=smtp.example.fr
DEALS_SMTP_PORT=587
DEALS_SMTP_TLS=starttls
DEALS_SMTP_USER=
DEALS_SMTP_PASSWORD=
DEALS_MAIL_FROM=Deals <bonjour@deals.example.fr>
# Plafond global d'e-mails de connexion par 24 h (sous le quota du fournisseur, ex. 300 par jour en offre gratuite).
DEALS_MAILS_PER_DAY=250

# Durée maximale de la passe de nuit, en secondes. En dessous, toutes les offres sont relues chaque nuit.
DEALS_NIGHT_BUDGET_S=14400
