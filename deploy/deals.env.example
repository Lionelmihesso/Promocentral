# /etc/deals/deals.env — lu par les services systemd (droits 600, propriétaire root).
# Adresse publique de l'app : sert aux liens de connexion ; en https, le cookie de session est marqué Secure.
DEALS_PUBLIC_URL=https://deals.example.fr

# Envoi des liens de connexion (n'importe quel fournisseur SMTP).
DEALS_SMTP_HOST=smtp.example.fr
DEALS_SMTP_PORT=587
DEALS_SMTP_TLS=starttls          # starttls (587) | ssl (465) | none (local uniquement)
DEALS_SMTP_USER=
DEALS_SMTP_PASSWORD=
DEALS_MAIL_FROM=Deals <bonjour@deals.example.fr>

# Durée maximale de la passe de nuit (secondes). En dessous, toutes les offres sont relues chaque jour.
DEALS_NIGHT_BUDGET_S=14400
