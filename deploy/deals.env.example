# /etc/deals/deals.env — lu par les services systemd et par la commande « deals » (droits 600, propriétaire root).
# Promo Central (nom de code technique : deals). Une valeur par ligne, sans commentaire en fin de ligne : systemd le
# garderait dans la valeur (la plateforme refuse alors de démarrer et nomme la variable).

# Adresse publique de l'app : liens de connexion ; en https, le cookie de session est marqué Secure et le navigateur est
# tenu au HTTPS (HSTS).
DEALS_PUBLIC_URL=https://promocentral.example.fr

# Mentions légales (page « Mentions légales » de l'app) : en production (DEALS_ENV=prod), l'app ne démarre pas sans elles.
DEALS_LEGAL_EDITOR=
DEALS_LEGAL_REGISTRATION=
DEALS_LEGAL_ADDRESS=
DEALS_LEGAL_DIRECTOR=
DEALS_LEGAL_CONTACT=
DEALS_LEGAL_HOST=

# Envoi des liens de connexion et des e-mails de missions, n'importe quel fournisseur SMTP.
# DEALS_SMTP_TLS : starttls (port 587) | ssl (port 465) | none (relais local uniquement).
DEALS_SMTP_HOST=smtp.example.fr
DEALS_SMTP_PORT=587
DEALS_SMTP_TLS=starttls
DEALS_SMTP_USER=
DEALS_SMTP_PASSWORD=
DEALS_MAIL_FROM=Promo Central <bonjour@promocentral.example.fr>
# Plafonds d'e-mails : liens de connexion par 24 h, e-mails de missions par nuit (au plus un par personne ; au-delà, la
# suite part la nuit suivante). Leur somme reste sous le quota du fournisseur (ex. 300 par jour en offre gratuite).
DEALS_MAILS_PER_DAY=250
DEALS_MISSION_MAILS=50

# Enseignes partenaires (affiliation) : fichier JSON enseigne → règle de lien (modèle : affiliate.example.json, dont
# les clés ne désignent aucune enseigne). Seules leurs offres sont lues et publiées ; chaque clic part par leur
# lien avec son identifiant. Vide : développement (tout est publié) — jamais en production.
DEALS_AFFILIATE=/etc/deals/affiliate.json

# Sources : le flux produits de chaque enseigne partenaire (exemple : sources.example.json, correspondances dans feeds/).
# Fichiers bruts des flux gardés DEALS_RAW_KEEP_DAYS jours, pour rejouer un lot ; taille maximale d'un flux en Mo.
DEALS_SOURCES=/etc/deals/sources.json
DEALS_RAW_DIR=/var/lib/deals/raw
DEALS_RAW_KEEP_DAYS=14
DEALS_FEED_MAX_MB=500
# Les adresses des flux portent les identifiants des réseaux : elles vivent ici, jamais dans sources.json
# (qui les cite par ${NOM}). À remplir pour chaque source activée ; vide, la source refuse de s'activer.
DEALS_FEED_BOULANGER=
DEALS_FEED_DARTY=
DEALS_FEED_FNAC=
DEALS_FEED_CONFORAMA=
DEALS_FEED_BUT=
DEALS_FEED_IKEA=
DEALS_FEED_MAISONSDUMONDE=
DEALS_FEED_LAREDOUTE=
DEALS_FEED_CDISCOUNT=

# Photos des produits (v67) : 1, la fiche et les cartes montrent la photo donnée par le flux de l'enseigne, chargée depuis
# son serveur (sans dire d'où vient la personne) ; 0, nos illustrations. Décidé (v68) : passer à 1 dès que les droits
# d'usage prévus par chaque programme d'affiliation sont vérifiés (la requête vers un tiers est dans « Mentions légales »).
DEALS_PHOTOS=0

# Exploitation autonome (docs/AUTONOMIE.md) : l'agent de nuit écrit au responsable au plus un e-mail par nuit, seulement
# s'il y a lieu (décision à prendre, source mise de côté, incident critique, incident qui se résout). Vide : personne.
DEALS_OPERATOR_EMAIL=exploitation@promocentral.example.fr
# Journal opérationnel aussi en JSON sur la sortie d'erreur (journald : journalctl -u deals-daily -o cat) ; env noté dans chaque ligne.
DEALS_LOG_JSON=1
DEALS_ENV=prod
