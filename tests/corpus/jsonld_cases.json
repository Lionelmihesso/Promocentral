{
"name": "custom.invalid/JSONLD_with_trailing_brace",
"html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <script type=\"application/ld+json\">\n{\n  \"@context\": \"http://schema.org\",\n  \"@type\": \"Product\",\n  \"name\": \"Black 'Clint' FT0511 cat eye sunglasses\",\n  \"image\": \"https://debenhams.scene7.com/is/image/Debenhams/60742_1515029001\",\n  \"brand\": {\n    \"@type\": \"Thing\",\n    \"name\": \"Tom Ford\"\n  },\n  \"offers\": {\n    \"@type\": \"Offer\",\n    \"priceCurrency\": \"GBP\",\n    \"price\": \"285.00\",\n    \"itemCondition\": \"http://schema.org/NewCondition\",\n    \"availability\": \"http://schema.org/InStock\"\n  }\n}}\n    </script>\n</head>\n\n<body></body>\n\n</html>\n",
"expected": [
{
"@context": "http://schema.org",
"@type": "Product",
"name": "Black 'Clint' FT0511 cat eye sunglasses",
"image": "https://debenhams.scene7.com/is/image/Debenhams/60742_1515029001",
"brand": {
"@type": "Thing",
"name": "Tom Ford"
},
"offers": {
"@type": "Offer",
"priceCurrency": "GBP",
"price": "285.00",
"itemCondition": "http://schema.org/NewCondition",
"availability": "http://schema.org/InStock"
}
}
]
},
{
"name": "custom.invalid/JSONLD_with_unescaped_quotes",
"html": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <script type=\"application/ld+json\">\n{\n  \"@context\": \"http://schema.org\",\n  \"@type\": \"Recipe\",\n  \"name\": \"Snowmen\",\n  \"recipeInstructions\": [\n    \"1. blablabla two \"buttons\".5. Dab  Snowmen!\"\n  ]\n}\n    </script>\n    <script type=\"application/ld+json\">\n{\n  \"@context\": \"http://schema.org\",\n  \"@type\": \"LocalBusiness\",\n  \"name\": \"Community Kitchen\",\n  \"description\": \"<p style=\"text-align: left;\">Open daily.</p>\"\n}\n    </script>\n</head>\n\n<body></body>\n\n</html>\n",
"expected": [
{
"@context": "http://schema.org",
"@type": "Recipe",
"name": "Snowmen",
"recipeInstructions": [
"1. blablabla two \"buttons\".5. Dab  Snowmen!"
]
},
{
"@context": "http://schema.org",
"@type": "LocalBusiness",
"name": "Community Kitchen",
"description": "<p style=\"text-align: left;\">Open daily.</p>"
}
]
},
